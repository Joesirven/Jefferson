# Postgres (Docker: docker compose up -d — mapped to host port 5433)
DATABASE_URL=postgresql://jefferson:jefferson@localhost:5433/jefferson

# LLM — Vercel AI Gateway (default)
LLM_PROVIDER=openai_compat
OPENAI_API_KEY=your-vercel-ai-gateway-key
OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
OPENAI_MODEL=alibaba/qwen-3-32b

# Alternate providers (set LLM_PROVIDER accordingly)
# GLM (Zhipu AI)
ZHIPUAI_API_KEY=your-glm-api-key
GLM_MODEL=glm-4-flash

# Gemini (Google) — also available via AI Gateway when GCP credits land
GEMINI_API_KEY=your-gemini-api-key

# Claude (Anthropic) — backup
ANTHROPIC_API_KEY=your-anthropic-api-key

# Direct DeepInfra (optional; bypass Gateway for lowest Qwen token cost)
# OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
# OPENAI_MODEL=Qwen/Qwen3-32B

# Dress-rehearsal pass threshold (percentage points)
DRESS_REHEARSAL_MARGIN_THRESHOLD=5

# Census API (optional, for ACS data)
CENSUS_API_KEY=your-census-api-key
